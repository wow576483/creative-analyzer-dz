# ===== 3ARSI environment (example) =====
# Copy to .env / configure as Cloudflare secrets. Never commit real secrets.

# --- API (Cloudflare Workers) ---
JWT_SECRET="change-me-long-random-string"
JWT_ISSUER="3arsi"
JWT_TTL_SECONDS="604800"            # 7 days

# Signed URL secret for R2 export links + PDF download tokens
SIGNED_URL_SECRET="change-me-another-random-string"

# Chargily Pay (https://dev.chargily.com) — Algerian payments
CHARGILY_SECRET_KEY="test_sk_xxx"
CHARGILY_WEBHOOK_SECRET="xxx"
CHARGILY_BASE_URL="https://pay.chargily.net/test/api/v2"

# Public price of the "3ARSI Wedding Package" in DZD
PACKAGE_PRICE_DZD="4900"

# Admin bootstrap (first admin account)
ADMIN_EMAIL="admin@3arsi.dz"
ADMIN_PASSWORD="change-me"

# Public URLs
APP_URL="http://localhost:3000"
API_URL="http://localhost:8787"

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:8787"
NEXT_PUBLIC_APP_NAME="3ARSI"
